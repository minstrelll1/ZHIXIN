                "path_nwz_m",
                "path_lon_lat_alt",
                "horizontal_distance_m"
              ],
              "additionalProperties": false
            },
            "return_route_distance_m": {
              "type": "number",
              "minimum": 0
            },
            "total_return_horizontal_distance_m": {
              "type": "number",
              "minimum": 0
            },
            "total_return_time_s": {
              "type": "number",
              "minimum": 0
            },
            "sensitivity_climb_speed_1_2_3_mps": {
              "type": "object",
              "properties": {
                "1": {
                  "type": "object",
                  "properties": {
                    "return_time_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "mission_time_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "within_1380_s": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "return_time_s",
                    "mission_time_s",
                    "within_1380_s"
                  ],
                  "additionalProperties": false
                },
                "2": {
                  "type": "object",
                  "properties": {
                    "return_time_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "mission_time_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "within_1380_s": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "return_time_s",
                    "mission_time_s",
                    "within_1380_s"
                  ],
                  "additionalProperties": false
                },
                "3": {
                  "type": "object",
                  "properties": {
                    "return_time_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "mission_time_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "within_1380_s": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "return_time_s",
                    "mission_time_s",
                    "within_1380_s"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "1",
                "2",
                "3"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "source_uav_id",
            "source_physical_layer",
            "waypoint_index",
            "waypoint_id",
            "last_scan_waypoint_id",
            "climb_start_nwz_m",
            "climb_end_nwz_m",
            "return_climb_mps",
            "return_climb_status",
            "return_climb_s",
            "connection_path",
            "return_route_distance_m",
            "total_return_horizontal_distance_m",
            "total_return_time_s",
            "sensitivity_climb_speed_1_2_3_mps"
          ],
          "additionalProperties": false
        },
        "status": {
          "const": "offline_geometry_requires_runtime_adapter"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "recipient_uav_id",
        "coordinate_frame",
        "local_frame",
        "coordinate_order",
        "altitude_frame",
        "runtime_schema_version",
        "route_scope",
        "waypoint_layer",
        "return_policy",
        "recipient_return_altitude_m",
        "reference_home",
        "entry_path",
        "retained_return_gate_points_m",
        "waypoint_counts_by_uav",
        "return_paths",
        "normal_return_connection",
        "status",
        "limitations"
      ],
      "additionalProperties": false
    }

            "waypoint_id": {
              "type": "string"
            },
            "last_scan_waypoint_id": {
              "type": "string"
            },
            "climb_start_nwz_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "climb_end_nwz_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "return_climb_mps": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "return_climb_status": {
              "enum": [
                "planner_provisional_unconfirmed",
                "not_required"
              ]
            },
            "return_climb_s": {
              "type": "number",
              "minimum": 0
            },
            "connection_path": {
              "type": "object",
              "properties": {
                "path_nwz_m": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "minItems": 2
                },
                "path_lon_lat_alt": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "minItems": 2
                },
                "horizontal_distance_m": {
                  "type": "number",
                  "minimum": 0

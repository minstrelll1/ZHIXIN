  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:planning:offline-return-catalog:1",
  "title": "Offline all-source recipient-height return catalog; not a runtime mission",
  "$defs": {
    "recipient": {
      "type": "object",
      "properties": {
        "recipient_uav_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "coordinate_frame": {
          "const": "WGS84"
        },
        "local_frame": {
          "const": "LOCAL_NORTH_WEST"
        },
        "coordinate_order": {
          "const": "longitude_latitude_relative_altitude"
        },
        "altitude_frame": {
          "const": "RELATIVE_TO_RECIPIENT_TAKEOFF"
        },
        "runtime_schema_version": {
          "const": 2
        },
        "route_scope": {
          "const": "all_uav_waypoints"
        },
        "waypoint_layer": {
          "enum": [
            "upper",
            "assigned_physical_layer"
          ]
        },
        "return_policy": {
          "enum": [
            "climb_to_upper_then_return",
            "at_task_altitude"
          ]
        },
        "recipient_return_altitude_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_home": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number"
            },
            "longitude": {
              "type": "number"
            },
            "home_nw_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "source": {
              "const": "nominal_reference_home"
            },
            "is_nominal": {
              "const": true
            }
          },
          "required": [
            "latitude",
            "longitude",
            "home_nw_m",
            "source",
            "is_nominal"
          ],
          "additionalProperties": false
        },
        "entry_path": {
          "type": "object",
          "properties": {
            "path_nwz_m": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 2
            },
            "path_lon_lat_alt": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 2
            },
            "horizontal_distance_m": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "path_nwz_m",
            "path_lon_lat_alt",
            "horizontal_distance_m"
          ],
          "additionalProperties": false
        },
        "retained_return_gate_points_m": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "waypoint_counts_by_uav": {
          "type": "object",
          "properties": {
            "1": {
              "type": "integer",
              "minimum": 1
            },
            "2": {
              "type": "integer",
              "minimum": 1
            },
            "3": {
              "type": "integer",
              "minimum": 1
            },
            "4": {
              "type": "integer",
              "minimum": 1
            },
            "5": {
              "type": "integer",
              "minimum": 1

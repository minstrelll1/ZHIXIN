        "return_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_uav_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "source_physical_layer": {
                "enum": [
                  "upper",
                  "lower"
                ]
              },
              "waypoint_index": {
                "type": "integer",
                "minimum": 1
              },
              "waypoint_id": {
                "type": "string"
              },
              "path_nwz_m": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "minItems": 2
              },
              "path_lon_lat_alt": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3

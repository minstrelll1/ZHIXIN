            "additionalProperties": false
          },
          "minItems": 6
        },
        "normal_return_connection": {
          "type": "object",
          "properties": {
            "source_uav_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "source_physical_layer": {
              "enum": [
                "upper",
                "lower"
              ]
            },
            "waypoint_index": {
              "type": "integer",
              "minimum": 1
